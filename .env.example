# Never put real values in this file.
GATEWAY_TOKEN_QIYUE_WEB=
GATEWAY_TOKEN_TODOAI=
GATEWAY_TOKEN_IOS=
GATEWAY_ADMIN_TOKEN=
DATABASE_URL=

GEMINI_API_KEY=
QWEN_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Optional provider/model overrides
GATEWAY_FAST_PROVIDER=gemini
GATEWAY_SMART_PROVIDER=gemini
# Project-specific provider priority for qy-fast/qy-smart. The authenticated
# project name is selected from the project token; clients cannot override it.
GATEWAY_QIYUE_WEB_ORDER=gemini,qwen,deepseek
GATEWAY_TODOAI_ORDER=gemini,qwen,deepseek
GATEWAY_IOS_ORDER=gemini,qwen,deepseek
GATEWAY_GEMINI_MODEL=gemini-2.5-flash
GATEWAY_QWEN_MODEL=qwen-plus
GATEWAY_DEEPSEEK_MODEL=deepseek-flash
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional pricing overrides, USD per 1M tokens. Leave unset to use the
# versioned built-in official list-price table in lib/pricing.mjs.
GATEWAY_QWEN_INPUT_PER_1M=
GATEWAY_QWEN_OUTPUT_PER_1M=
GATEWAY_DEEPSEEK_INPUT_PER_1M=
GATEWAY_DEEPSEEK_OUTPUT_PER_1M=
GATEWAY_GEMINI_INPUT_PER_1M=
GATEWAY_GEMINI_OUTPUT_PER_1M=
# Approximate CNY -> USD conversion used only for dashboard estimates.
# Change this when you want to pin a different accounting rate.
GATEWAY_CNY_TO_USD=0.14
